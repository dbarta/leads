<% Current.meta_tags.set(title: "Dashboard") %>

<div class="container mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6">Dashboard</h1>

  <%# Airport summary stats %>
  <% airport_count = Airport.count %>
  <% if airport_count > 0 %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      <% Airport.group(:discovery_status).count.sort_by { |s, _| Airport::DISCOVERY_STATUSES.index(s) || 99 }.each do |status, count| %>
        <div class="bg-white border border-gray-200 rounded-lg px-4 py-4 shadow-sm text-center">
          <div class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(count) %></div>
          <div class="text-xs text-gray-500 mt-1"><%= status.humanize %></div>
        </div>
      <% end %>
      <div class="bg-white border border-gray-200 rounded-lg px-4 py-4 shadow-sm text-center">
        <div class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(airport_count) %></div>
        <div class="text-xs text-gray-500 mt-1">Total airports</div>
      </div>
    </div>

    <div class="flex gap-3 mb-8">
      <%= link_to "Browse airports", airports_path, class: "bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium hover:bg-blue-700" %>
      <%= link_to "Activity log", activity_logs_path, class: "bg-gray-100 text-gray-700 px-4 py-2 rounded text-sm font-medium hover:bg-gray-200" %>
    </div>
  <% else %>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-5 mb-8">
      <h2 class="font-semibold text-amber-800 mb-1">No airports imported yet</h2>
      <p class="text-sm text-amber-700 mb-3">Import the FAA NASR airport dataset to get started.</p>
      <code class="block bg-white border border-amber-200 rounded px-3 py-2 text-sm font-mono text-gray-700">
        rake airports:import_faa
      </code>
    </div>
  <% end %>

  <%# Recent activity %>
  <% recent_logs = ActivityLog.recent.limit(10).includes(:airport) %>
  <% if recent_logs.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
      <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="font-semibold text-gray-800">Recent Activity</h2>
        <%= link_to "View all →", activity_logs_path, class: "text-sm text-blue-600 hover:underline" %>
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-gray-100">
          <% recent_logs.each do |log| %>
            <tr class="hover:bg-gray-50 <%= "bg-red-50" if log.failed? %>">
              <td class="px-5 py-3 text-xs text-gray-400 whitespace-nowrap w-40 font-mono">
                <%= log.occurred_at.strftime("%m-%d %H:%M:%S") %>
              </td>
              <td class="px-3 py-3 w-24">
                <% status_css = log.failed? ? "bg-red-100 text-red-800" : "bg-green-100 text-green-800" %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_css %>">
                  <%= log.status&.humanize %>
                </span>
              </td>
              <td class="px-3 py-3 font-mono text-xs text-gray-500 w-48"><%= log.action_name %></td>
              <td class="px-3 py-3 text-gray-700 truncate max-w-sm"><%= log.summary %></td>
              <td class="px-3 py-3 text-xs">
                <% if log.airport %>
                  <%= link_to log.airport.faa_code, airport_path(log.airport),
                      class: "font-mono text-blue-600 hover:underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
