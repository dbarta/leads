<% css = case status
  when "completed"                 then "bg-green-100 text-green-800"
  when "completed_no_sources"      then "bg-yellow-100 text-yellow-800"
  when "completed_no_providers"    then "bg-yellow-100 text-yellow-800"
  when "running"                   then "bg-blue-100 text-blue-800"
  when "queued"                    then "bg-indigo-100 text-indigo-800"
  when "failed"                    then "bg-red-100 text-red-800"
  when "needs_review"              then "bg-orange-100 text-orange-800"
  else                                  "bg-gray-100 text-gray-500"
  end %>
<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= css %>">
  <%= status.to_s.humanize %>
</span>
