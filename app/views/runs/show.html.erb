<% Current.meta_tags.set(title: @run.name) %>

<div class="container mx-auto px-4 py-6 max-w-3xl">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to "← Runs", runs_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <div class="flex items-start justify-between mb-4">
      <h1 class="text-2xl font-bold"><%= @run.name %></h1>
      <%= link_to "Edit", edit_run_path(@run), class: "text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded hover:bg-gray-200" %>
    </div>

    <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <% if @run.started_at %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Period</dt>
          <dd class="mt-0.5 text-gray-900">
            <%= @run.started_at.strftime("%-m/%-d/%Y") %>
            <% if @run.completed_at %>– <%= @run.completed_at.strftime("%-m/%-d/%Y") %><% end %>
          </dd>
        </div>
      <% end %>

      <div>
        <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Contacts</dt>
        <dd class="mt-0.5">
          <%= link_to "#{@run.contact_count} contacts", contacts_path(run_id: @run.id), class: "text-blue-600 hover:underline font-medium" %>
        </dd>
      </div>

      <% if @run.airports.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">Airports</dt>
          <dd class="mt-0.5 font-mono text-gray-900"><%= @run.airports %></dd>
        </div>
      <% end %>

      <% if @run.naics_codes.present? %>
        <div>
          <dt class="text-xs font-medium text-gray-500 uppercase tracking-wide">NAICS Codes</dt>
          <dd class="mt-0.5 font-mono text-gray-900"><%= @run.naics_codes %></dd>
        </div>
      <% end %>
    </dl>

    <% if @run.processes.present? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Pipeline / Processes</div>
        <p class="text-sm text-gray-700"><%= @run.processes %></p>
      </div>
    <% end %>

    <% if @run.notes.present? %>
      <div class="mt-3">
        <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Notes</div>
        <p class="text-sm text-gray-600 italic"><%= @run.notes %></p>
      </div>
    <% end %>
  </div>
</div>
