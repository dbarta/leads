<% Current.meta_tags.set(title: "New Run") %>

<div class="container mx-auto px-4 py-6 max-w-2xl">
  <div class="mb-6">
    <%= link_to "← Runs", runs_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
  <h1 class="text-2xl font-bold mb-6">New Run</h1>
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
    <%= render "form", run: @run %>
  </div>
</div>
