<% Current.meta_tags.set(title: "Activity Log") %>

<div class="container mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Activity Log</h1>
    <div class="text-sm text-gray-500"><%= number_with_delimiter(@pagy.count) %> entries</div>
  </div>

  <%# Filters %>
  <%= form_with url: activity_logs_path, method: :get do |f| %>
    <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6 shadow-sm">
      <div class="flex flex-wrap gap-3 items-end">
        <div>
          <%= f.label :action_name, "Action", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.select :action_name, [["All actions", ""]] + @action_names.map { |a| [a.humanize, a] },
              {selected: params[:action_name]},
              class: "border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :status, "Status", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.select :status, [["Any status", ""]] + @statuses.map { |s| [s.humanize, s] },
              {selected: params[:status]},
              class: "border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :actor_type, "Actor", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.select :actor_type, [["Any actor", ""]] + @actor_types.map { |a| [a.humanize, a] },
              {selected: params[:actor_type]},
              class: "border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :since, "From", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.date_field :since, value: params[:since],
              class: "border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :until, "To", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.date_field :until, value: params[:until],
              class: "border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div class="flex items-center gap-2 pb-0.5">
          <%= f.check_box :failures_only, checked: params[:failures_only] == "1",
              class: "rounded border-gray-300 text-red-600 focus:ring-red-500" %>
          <%= f.label :failures_only, "Failures only", class: "text-sm text-gray-700" %>
        </div>

        <div class="flex gap-2">
          <%= f.submit "Filter", class: "bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium hover:bg-blue-700 cursor-pointer" %>
          <%= link_to "Clear", activity_logs_path, class: "bg-gray-100 text-gray-700 px-4 py-2 rounded text-sm font-medium hover:bg-gray-200" %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Log table %>
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
    <% if @logs.any? %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-40">Time</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-24">Status</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-32">Actor</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-48">Action</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Summary</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-32">Airport</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-20">Duration</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @logs.each do |log| %>
            <tr class="hover:bg-gray-50 <%= "bg-red-50" if log.failed? %>">
              <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap font-mono">
                <%= log.occurred_at.strftime("%Y-%m-%d %H:%M:%S") %>
              </td>
              <td class="px-4 py-3">
                <% status_css = case log.status
                  when "success" then "bg-green-100 text-green-800"
                  when "failed"  then "bg-red-100 text-red-800"
                  else                "bg-gray-100 text-gray-600"
                  end %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_css %>">
                  <%= log.status&.humanize || "—" %>
                </span>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500"><%= log.actor_type %></td>
              <td class="px-4 py-3 font-mono text-xs text-gray-700"><%= log.action_name %></td>
              <td class="px-4 py-3 text-gray-700">
                <div class="truncate max-w-sm" title="<%= log.summary %>"><%= log.summary %></div>
                <% if log.error_message.present? %>
                  <div class="text-xs text-red-600 mt-0.5 truncate max-w-sm" title="<%= log.error_message %>">
                    <%= log.error_message %>
                  </div>
                <% end %>
              </td>
              <td class="px-4 py-3 text-xs">
                <% if log.airport %>
                  <%= link_to log.airport.faa_code, airport_path(log.airport),
                      class: "font-mono text-blue-600 hover:underline" %>
                <% end %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500">
                <% if log.duration_ms %>
                  <%= log.duration_ms >= 1000 ? "#{(log.duration_ms / 1000.0).round(1)}s" : "#{log.duration_ms.round}ms" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @pagy.last > 1 %>
        <div class="px-4 py-3 border-t border-gray-200 flex items-center justify-between">
          <div class="text-sm text-gray-500">
            Page <%= @pagy.page %> of <%= @pagy.pages %>
          </div>
          <div class="flex gap-1">
            <%== @pagy.series_nav %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">
        <p class="text-lg font-medium mb-2">No activity log entries found</p>
        <% if params.to_unsafe_h.except("action", "controller").any? %>
          <p class="text-sm">Try adjusting your filters.</p>
          <%= link_to "Clear filters", activity_logs_path, class: "mt-2 inline-block text-blue-600 hover:underline text-sm" %>
        <% else %>
          <p class="text-sm">Activity will appear here once the FAA import or other actions run.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
